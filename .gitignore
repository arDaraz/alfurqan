*.db-shm
*.db-wal
*.db-journal

# generated native folders
/ios
/android

# Claude Code local tooling
.claude/worktrees/

# mobile-verify simulator proofs
.claude/mobile-verify/

# Images and video are ignored everywhere, then allowed back only where they
# belong. Listing the folders to ignore was tried and failed: every tool that
# captured a simulator screenshot invented its own path and slipped past it.
# Committing one now needs `git add -f`, which makes it a decision.
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.mp4
*.mov
!assets/**
!.github/**

# SQLite sidecar files the running app creates next to the bundled database
*.db-shm
*.db-wal

# Simulator device id written per worktree by the wt post-start hook
.simulator-udid

# End-to-end and manual QA reports. Local working history, not shared record.
# Findings that must survive go in the pull request or a tracker issue.
docs/qa/
