{
  "name": "alfurqan",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "dev": "expo start --dev-client -c --lan --port 8081",
    "dev:port": "lsof -nP -iTCP:8081 -sTCP:LISTEN",
    "dev:stop": "sh -c 'for port in 8081 8082; do pids=$(lsof -tiTCP:$port -sTCP:LISTEN); if [ -n \"$pids\" ]; then echo \"Stopping Metro on port $port: $pids\"; kill $pids; for i in 1 2 3 4 5; do sleep 0.2; lsof -tiTCP:$port -sTCP:LISTEN >/dev/null || break; done; else echo \"No process is listening on port $port\"; fi; done'",
    "dev:restart": "npm run dev:stop && npm run dev",
    "native:clean": "rm -rf /tmp/alfurqan-ios-device-build ~/Library/Developer/Xcode/DerivedData/AlFurqan-*",
    "phone:build": "scripts/ios-physical.sh build",
    "phone:install": "scripts/ios-physical.sh install",
    "phone:launch": "scripts/ios-physical.sh launch",
    "phone:rebuild": "scripts/ios-physical.sh rebuild",
    "phone:native": "npm run dev:stop && npm run phone:rebuild && npm run dev",
    "phone:repair": "npm run phone:native",
    "sim:rebuild": "npm run native:clean && expo run:ios --no-build-cache --no-bundler",
    "sim:native": "npm run sim:rebuild && npm run dev:restart",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "jest",
    "seed": "npx tsx src/data/seed/buildQuranDb.ts",
    "seed:mushaf": "npx tsx src/data/seed/seedMushafData.ts",
    "seed:mushaf-layouts": "npx tsx scripts/build-mushaf-content-packs.ts"
  },
  "dependencies": {
    "@react-navigation/bottom-tabs": "^7.15.5",
    "@react-navigation/elements": "^2.9.10",
    "@react-navigation/native": "^7.1.33",
    "@shopify/flash-list": "2.0.2",
    "adhan": "^4.4.4",
    "expo": "~55.0.17",
    "expo-audio": "~55.0.14",
    "expo-clipboard": "~55.0.13",
    "expo-constants": "~55.0.9",
    "expo-dev-client": "~55.0.28",
    "expo-device": "~55.0.15",
    "expo-file-system": "~55.0.17",
    "expo-font": "~55.0.4",
    "expo-glass-effect": "~55.0.10",
    "expo-haptics": "~55.0.14",
    "expo-image": "~55.0.9",
    "expo-linear-gradient": "~55.0.13",
    "expo-linking": "~55.0.14",
    "expo-location": "~55.1.12",
    "expo-modules-core": "55.0.23",
    "expo-router": "~55.0.13",
    "expo-splash-screen": "~55.0.19",
    "expo-sqlite": "~55.0.15",
    "expo-status-bar": "~55.0.5",
    "expo-symbols": "~55.0.7",
    "expo-system-ui": "~55.0.16",
    "expo-web-browser": "~55.0.14",
    "nativewind": "^4.2.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-mmkv": "^4.3.0",
    "react-native-nitro-modules": "^0.35.2",
    "react-native-pager-view": "^8.0.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-web": "~0.21.0",
    "react-native-webview": "^13.16.0",
    "react-native-worklets": "0.7.4",
    "zustand": "^5.0.12",
    "zustand-mmkv-storage": "^1.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "better-sqlite3": "^12.8.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~55.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~55.0.16",
    "tailwindcss": "^3.4.19",
    "ts-jest": "^29.4.6",
    "tsx": "^4.21.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
