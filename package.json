{
  "name": "alfurqan",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "node scripts/expo-run.mjs start --dev-client --lan --port 8081",
    "dev": "npm run start",
    "dev:port": "node scripts/expo-run.mjs status",
    "dev:stop": "node scripts/expo-run.mjs stop",
    "native:sync": "expo prebuild --clean",
    "ios": "node scripts/expo-run.mjs run:ios --port 8081",
    "ios:device": "node scripts/expo-run.mjs run:ios --device --port 8081",
    "ios:rebuild": "expo prebuild --clean --platform ios && npm run ios -- --no-build-cache",
    "ios:device:rebuild": "expo prebuild --clean --platform ios && npm run ios:device -- --no-build-cache",
    "android": "node scripts/expo-run.mjs run:android --port 8081",
    "android:rebuild": "expo prebuild --clean --platform android && npm run android",
    "reset-project": "node ./scripts/reset-project.js",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "jest",
    "seed": "npx tsx src/data/seed/buildQuranDb.ts",
    "seed:mushaf": "npx tsx src/data/seed/seedMushafData.ts",
    "seed:mushaf-layouts": "npx tsx scripts/build-mushaf-content-packs.ts"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-navigation/bottom-tabs": "^7.15.5",
    "@react-navigation/elements": "^2.9.10",
    "@react-navigation/native": "^7.1.33",
    "@shopify/flash-list": "2.0.2",
    "adhan": "^4.4.4",
    "expo": "^57.0.13",
    "expo-asset": "~57.0.11",
    "expo-audio": "~57.0.3",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.11",
    "expo-dev-client": "~57.0.12",
    "expo-device": "~57.0.1",
    "expo-file-system": "~57.0.4",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.3",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.6",
    "expo-location": "~57.0.10",
    "expo-router": "~57.0.13",
    "expo-splash-screen": "~57.0.6",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "nativewind": "^4.2.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-mmkv": "^4.3.0",
    "react-native-nitro-modules": "^0.35.2",
    "react-native-pager-view": "8.0.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.12",
    "zustand-mmkv-storage": "^1.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "better-sqlite3": "^12.8.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.1",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.4",
    "tailwindcss": "^3.4.19",
    "ts-jest": "^29.4.12",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3"
  },
  "private": true
}
